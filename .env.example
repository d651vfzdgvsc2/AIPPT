# ===== DeepSeek 大模型 API 配置（必填项：DEEPSEEK_API_KEY）=====

# 你的 DeepSeek API Key（必填，控制台获取）
DEEPSEEK_API_KEY=

# 接口地址（默认官方接口，一般无需修改）
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions

# 模型 ID：需要「上传图片理解」时，请使用视觉模型（或你在控制台创建的接入点 ID）
DEEPSEEK_MODEL=deepseek-v4-flash-vision-exp

# 单次生成最大 token
MAX_TOKENS=4000

# 单 IP 每分钟请求上限
RATE_LIMIT_PER_MIN=10

# ===== 服务监听配置（可选）=====
# 0.0.0.0 表示局域网可访问；只在本机演示可改成 127.0.0.1
HOST=127.0.0.1
PORT=5000
